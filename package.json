{
  "name": "my-offer-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e": "playwright test",
    "db:test": "bash scripts/db-local.sh reset && for f in tests/db/*.sql; do case $f in *supabase-stubs.sql) continue;; esac; bash scripts/db-local.sh psql -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done",
    "db:seed": "bash scripts/db-local.sh reset",
    "db:gen-seed": "node --experimental-strip-types scripts/gen-seed.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
