# Địa chỉ website (dùng cho sitemap, canonical)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Để trống 3 biến Supabase dưới đây = chế độ minh họa (demo), không gửi hồ sơ thật
NEXT_PUBLIC_SUPABASE_URL=
# Khóa anon công khai của Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Khóa service role: CHỈ dùng ở server (lib/supabase/admin.ts), không bao giờ thêm tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Chuỗi bí mật ngẫu nhiên để băm IP khi chống spam; CHỈ dùng ở server
IP_HASH_SALT=
