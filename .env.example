# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Để trống NEXT_PUBLIC_SUPABASE_URL = chế độ minh họa (demo): dữ liệu mẫu, không gửi hồ sơ thật, /admin chỉ hiện thông báo.

# Công khai. Địa chỉ website (sitemap, canonical). Production: https://ten-mien-cua-ban
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Công khai. URL dự án Supabase (Project Settings > API). Để trống = chế độ demo.
NEXT_PUBLIC_SUPABASE_URL=
# Công khai. Khóa anon (an toàn để lộ ra trình duyệt; quyền bị giới hạn bởi RLS). Bắt buộc nếu đã đặt URL.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# CHỈ SERVER, bí mật. Khóa service role (lib/supabase/admin.ts). Không bao giờ thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# CHỈ SERVER, bí mật. Chuỗi ngẫu nhiên dài để băm IP khi chống spam. Ví dụ tạo: openssl rand -hex 32
IP_HASH_SALT=
